{
  "name": "@timeaway/telegram-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "BOT_MODE=polling tsx watch src/index.ts",
    "start": "node dist/index.js",
    "webhook:set": "tsx src/scripts/set-webhook.ts"
  },
  "dependencies": {
    "@timeaway/constraint-parsing": "workspace:*",
    "@timeaway/database": "workspace:*",
    "@timeaway/shared": "workspace:*",
    "@timeaway/trip-engine": "workspace:*",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
