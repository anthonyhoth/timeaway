# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Postgres connection string (Neon in production)
DATABASE_URL=postgres://user:pass@host/db

# webhook (production) | polling (local dev). pnpm dev forces polling.
BOT_MODE=webhook

# Required in webhook mode; any long random string. Telegram echoes it back
# on every update so we know requests are genuine.
TELEGRAM_WEBHOOK_SECRET=

# Base URL used in shared trip links
PUBLIC_BASE_URL=https://gettimeaway.com

# Only for pnpm webhook:set — the deployed webhook endpoint
WEBHOOK_URL=https://<railway-host>/telegram/webhook
